<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Continuum</AssemblyName>
    <RootNamespace>Continuum</RootNamespace>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time reference only: OpenTabletDriver.Plugin.dll must NOT be shipped with the plugin. -->
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.8" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Continuum.Tests" />
  </ItemGroup>

</Project>
